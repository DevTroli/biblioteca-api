{
  "info": {
    "name": "Biblioteca API",
    "description": "Fluxo completo do CRUD de livros. Rode com o Collection Runner, na ordem.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Criar livro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/livros", "host": ["{{baseUrl}}"], "path": ["livros"] },
        "body": { "mode": "raw", "raw": "{\"titulo\":\"Dom Casmurro\",\"autor\":\"Machado de Assis\",\"isbn\":\"9788535910663\",\"anoPublicacao\":1899}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('livroId', pm.response.json().id);"] } }]
    },
    {
      "name": "2. Criar livro com ISBN repetido (409)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/livros", "host": ["{{baseUrl}}"], "path": ["livros"] },
        "body": { "mode": "raw", "raw": "{\"titulo\":\"Dom Casmurro\",\"autor\":\"Machado de Assis\",\"isbn\":\"9788535910663\",\"anoPublicacao\":1899}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"] } }]
    },
    {
      "name": "3. Criar livro sem titulo (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/livros", "host": ["{{baseUrl}}"], "path": ["livros"] },
        "body": { "mode": "raw", "raw": "{\"titulo\":\"\",\"autor\":\"Autor\",\"isbn\":\"0000000000000\"}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "4. Listar livros",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/livros", "host": ["{{baseUrl}}"], "path": ["livros"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "5. Buscar livro por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/livros/{{livroId}}", "host": ["{{baseUrl}}"], "path": ["livros", "{{livroId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "6. Atualizar livro",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/livros/{{livroId}}", "host": ["{{baseUrl}}"], "path": ["livros", "{{livroId}}"] },
        "body": { "mode": "raw", "raw": "{\"titulo\":\"Dom Casmurro (edicao revisada)\",\"autor\":\"Machado de Assis\",\"isbn\":\"9788535910663\",\"anoPublicacao\":1899}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "7. Deletar livro",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/livros/{{livroId}}", "host": ["{{baseUrl}}"], "path": ["livros", "{{livroId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] } }]
    },
    {
      "name": "8. Buscar livro deletado (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/livros/{{livroId}}", "host": ["{{baseUrl}}"], "path": ["livros", "{{livroId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "livroId", "value": "" }
  ]
}
